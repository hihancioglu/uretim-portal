DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_SECURE_COOKIES=false
POSTGRES_DB=uretim_portal
POSTGRES_USER=uretim_portal
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
DRAWING_STORAGE_BACKEND=filesystem
DRAWING_STORAGE_ROOT=/data/drawings
DRAWING_MAX_UPLOAD_BYTES=104857600

OIDC_ENABLED=false
OIDC_ISSUER_URL=https://auth.example.invalid/application/o/uretim-portal
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=https://portal.example.invalid/auth/callback/
OIDC_POST_LOGOUT_REDIRECT_URI=https://portal.example.invalid/
OIDC_AUTO_PROVISION=false
